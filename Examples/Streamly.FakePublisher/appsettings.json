{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Streamly": "Debug",
      "Streamly.Test": "Debug"
    }
  },
  "Streamly": {
    "ProcessName": "SpotPricingService",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "ConnectTimeoutMs": 5000,
      "ConnectRetryCount": 3,
      "AbortOnConnectFail": false
    },
    "LeaderElection": {
      "HeartbeatInterval": "00:00:00.200",
      "LockTtl": "00:00:01",
      "DeadThreshold": "00:00:00.500"
    },
    "StateSync": {
      "BatchSyncInterval": "00:00:15"
    }
  }
}