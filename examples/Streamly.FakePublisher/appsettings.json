{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Streamly": "Information",
      "Streamly.Test": "Information",
      "Streamly.Server.RequestManagement.RequestManager": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  
  "Streamly": {
    "ServiceName": "SpotPricer",
    "ClusterId": "cluster-default",
    "SubscriberHeartbeatTimeoutMs" : 10000,

    "Nats": {
      "Url": "nats://localhost:4222",
      "ConnectionName": "Streamly-Publisher",
      "MaxReconnectAttempts": -1
    }
  },

  "SpotPricingFilter": {
    "AllowedCurrencyPairs": [ "EURUSD", "EURGBP" ]
  }
}