@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>

    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"/>
        <MudText Typo="Typo.h6" Class="ml-2" Style="font-weight:600; letter-spacing:.5px;">
            Streamly
        </MudText>
        <MudText Typo="Typo.caption" Class="ml-2 mt-1" Style="opacity:.6;">
            monitoring dashboard
        </MudText>
        <MudSpacer/>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode"/>
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.subtitle2" Style="opacity:.5; font-size:.7rem; letter-spacing:.08em; text-transform:uppercase;">
                Navigation
            </MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Dashboard">
                Cluster Overview
            </MudNavLink>
            <MudNavLink Href="/audit"
                        Icon="@Icons.Material.Filled.History">
                Audit Replay
            </MudNavLink>
            <MudDivider Class="my-2"/>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = true;

    void ToggleDrawer()  => _drawerOpen = !_drawerOpen;
    void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary        = "#185FA5",
            Secondary      = "#854F0B",
            Success        = "#3B6D11",
            Warning        = "#854F0B",
            AppbarBackground = "#1e1e2e",
            AppbarText     = "#ffffff",
        },
        PaletteDark = new PaletteDark
        {
            Primary        = "#4A9EDB",
            Secondary      = "#D4A55A",
            Success        = "#6DBF45",
            Warning        = "#D4A55A",
            Surface        = "#1e1e2e",
            Background     = "#13131f",
            AppbarBackground = "#13131f",
            DrawerBackground = "#1a1a2e",
        }
    };
}
