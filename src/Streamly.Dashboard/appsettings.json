{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Streamly.Dashboard": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Streamly": {
    "Dashboard": {
      "PollIntervalMs": 2000,
      "Instances": [
        {
          "Id": "Provider A",
          "BaseUrl": "http://localhost:5101",
          "Label": "Provider A"
        },
        {
          "Id": "Provider B",
          "BaseUrl": "http://localhost:5102",
          "Label": "Provider B"
        },
        {
          "Id": "Subscriber A",
          "BaseUrl": "http://localhost:6001",
          "Label": "Subscriber A"
        },
        {
          "Id": "Subscriber B",
          "BaseUrl": "http://localhost:6002",
          "Label": "Subscriber B"
        }
      ]
    },
    "Nats": {
      "Url": "nats://localhost:4222"
    },
    "Audit": {
      "JetStreamName": "STREAMLY_AUDIT",
      "SubjectPrefix": "audit",
      "RetentionDays": 14,
      "MaxStorageGb": 10,
      "StreamReplicas": 1,
      "CreateStreamOnStartup": false
    }
  }
}